          "id": "e2a5406e-441d-4b77-8590-37bec19998f4",
          "name": "Stream notifications for a given user via the SSE protocol.",
          "request": {
            "name": "Stream notifications for a given user via the SSE protocol.",
            "description": {
              "content": "This uses long-polling to keep the connection open for several minutes at a time (or longer) and should be requested with an EventSource object or other SSE-capable client. <p>Notifications are returned within a few seconds of when they occur.  When no notification occurs for the timeout duration, the stream is closed. <p>This connection can stay open indefinitely long.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "notification",
                "stream"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "timeout",
                  "value": "300",
                  "description": "The duration without a notification before the stream is closed."
                },
                {
                  "disabled": false,
                  "key": "since",
                  "value": "<integer>",
                  "description": "Filter out events before this time stamp."
                }
              ],
              "variable": []
            },
            "method": "GET",
            "auth": null
          },
